# Project Lucas - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git - it contains secrets

# ===== Required for cPanel/Hosted =====
# Set to true when deploying to production
IS_HOSTED=true

# Flask secret key - generate a random string for production
SECRET_KEY=your-secret-key-change-in-production

# Database (cPanel MySQL)
DB_HOST=localhost
DB_USER=your_cpanel_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_cpanel_db_name

# ===== Optional - Email =====
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@yourschool.com

# ===== Optional - Contact info for emails =====
SUPPORT_EMAIL=support@yourschool.com
SUPPORT_PHONE=+254 700 000 000
SCHOOL_NAME=Modern School
