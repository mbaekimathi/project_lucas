# =============================================================================
# Elimu Centric - Environment Configuration (Production Template)
# =============================================================================
# Copy this file to .env:  cp .env.example .env
# Verify config:  python check_env.py
# NEVER commit .env to git - it contains secrets (already in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# ENVIRONMENT CHECK - Controls local vs hosted mode
# -----------------------------------------------------------------------------
# IS_HOSTED=true  -> uses HOSTED database credentials (cPanel/production)
# IS_HOSTED=false -> uses LOCAL database credentials (development)
# -----------------------------------------------------------------------------
IS_HOSTED=false

# -----------------------------------------------------------------------------
# DATABASE - Set values for your active mode (see IS_HOSTED above)
# -----------------------------------------------------------------------------
# LOCAL (IS_HOSTED=false): use root / modern_school
# HOSTED (IS_HOSTED=true): use cPanel user / elimucentric_school
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=modern_school

# -----------------------------------------------------------------------------
# SECURITY - Required for both modes
# -----------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# -----------------------------------------------------------------------------
# EMAIL (optional)
# -----------------------------------------------------------------------------
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@yourschool.com

# -----------------------------------------------------------------------------
# SUPPORT (optional)
# -----------------------------------------------------------------------------
SUPPORT_EMAIL=support@yourschool.com
SUPPORT_PHONE=+254 700 000 000
SCHOOL_NAME=Modern School
