# Passenger configuration for Flask application (cPanel)
# IMPORTANT: Update PassengerAppRoot to your actual server path after git pull
# Example: /home/username/public_html or /home1/account/elimu_centric
PassengerEnabled On
PassengerAppRoot /home1/projectl/elimu_centric
PassengerBaseURI /
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
PassengerPython /usr/bin/python3

# Enable Passenger
PassengerFriendlyErrorPages On

# Set environment variables (if needed)
# SetEnv SECRET_KEY your-secret-key-here

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

