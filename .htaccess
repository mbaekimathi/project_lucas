# Passenger / LiteSpeed configuration for Flask (cPanel)
# IMPORTANT: set PassengerAppRoot to THIS app's real path on the server
# (cPanel → Setup Python App shows the path). Wrong path = Internal Server Error.
PassengerEnabled On
PassengerAppRoot /home1/projectl/elimu_centric
PassengerBaseURI /
PassengerAppType wsgi
PassengerStartupFile passenger_wsgi.py
PassengerPython /usr/bin/python3

PassengerFriendlyErrorPages On

# Optional LiteSpeed worker cap (safe if LiteSpeed is not present)
<IfModule LiteSpeed>
  SetEnv LSAPI_CHILDREN 4
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
