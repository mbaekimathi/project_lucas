# cPanel / production — copy to .env (only on the server; not for your laptop)
# Do not add .env.local on the server.

IS_HOSTED=true
DB_HOST=localhost
DB_USER=your_cpanel_mysql_user
DB_NAME=your_cpanel_database_name
DB_PASSWORD=your_cpanel_mysql_password

SECRET_KEY=generate_with_openssl_rand_hex_32

SCHOOL_SETTINGS_CACHE_TTL=300
STATIC_MAX_AGE=86400

SCHOOL_NAME=Your School Name
SUPPORT_EMAIL=support@yourschool.com
SUPPORT_PHONE=+254 700 000 000

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
