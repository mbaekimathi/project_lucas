# Local development — copy to .env.local (never use production DB credentials here)
# .env.local is gitignored.

IS_HOSTED=false
DB_HOST=127.0.0.1
DB_USER=root
DB_NAME=modern_school
# Empty = no password (typical for local root@localhost on Windows/XAMPP)
DB_PASSWORD=

SECRET_KEY=dev-only-use-a-different-random-string-locally

SCHOOL_SETTINGS_CACHE_TTL=300
STATIC_MAX_AGE=0

SCHOOL_NAME=Local Dev School
SUPPORT_EMAIL=dev@localhost
SUPPORT_PHONE=

# Links in parent approval emails (local dev)
APP_DOMAIN=http://127.0.0.1:5000

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Google Drive — sign in on the backup page (recommended)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5000/database/google-drive/callback
OAUTHLIB_INSECURE_TRANSPORT=1

# Optional service account instead of user sign-in (never commit the key file)
# GOOGLE_DRIVE_CREDENTIALS_FILE=config/google-drive-service-account.json
# GOOGLE_DRIVE_CREDENTIALS_JSON=
